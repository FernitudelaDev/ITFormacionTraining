					</Method>
					<Method>
						<Name>loadTmpData</Name>
						<Source><![CDATA[
        private void loadTmpData()
        {
            ACtmpAuthorTable tmpAuthorTable;
            ACtmpAuthorTable tmpAuthorTable2;

            ACAuthorTable authorTable;

            while select authorTable
            {
                if(RandomGenerate::construct().randomInt(1, 2) == 2 )
                {
                    tmpAuthorTable.initFromAuthorTable(authorTable);
                    tmpAuthorTable.insert();
                }
            }

            ACtmpAuthorTable.setTmpData(tmpAuthorTable);

            while select tmpAuthorTable
            {
                info(tmpAuthorTable.Id);
            }

            tmpAuthorTable2.setTmpData(tmpAuthorTable);

            while select tmpAuthorTable2
            {
                warning(tmpAuthorTable2.FirstName);
            }
        }

]]></Source>
