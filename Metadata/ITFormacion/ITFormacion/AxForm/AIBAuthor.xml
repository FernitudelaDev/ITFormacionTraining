						<Source><![CDATA[
        public int active()
        {
            int ret;

            ret = super();

            AIBAuthorTable.setDeathDateEditableInForm();

            return ret;
        }

]]></Source>
					</Method>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            Query authorQuery = AIBAuthorTable_ds.query();

            QueryBuildDataSource qbds = authorQuery.dataSourceTable(tableNum(AIBAuthorTable));

            qbrBirthDate = qbds.addRange(fieldNum(AIBAuthorTable,BirthDate));
            qbrDeathDate = qbds.addRange(fieldNum(AIBAuthorTable,DeathDate));
            qbrDeathDateNullCheck = qbds.addRange(fieldNum(AIBAuthorTable,DeathDate));

        }

]]></Source>
					</Method>
				</Methods>
				<Fields />
			</DataSource>
