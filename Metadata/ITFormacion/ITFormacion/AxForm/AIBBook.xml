						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            if(needGenreFilter)
            {
                this.clearExistingLinksAndAddGenreRange();
            }
        }

]]></Source>
					</Method>
					<Method>
						<Name>clearExistingLinksAndAddGenreRange</Name>
						<Source><![CDATA[
        private void clearExistingLinksAndAddGenreRange()
        {
            QueryBuildDataSource qbds = AIBBookTable_q.dataSourceTable(tableNum(AIBBookTable));

            qbds.clearDynalinks();

            QueryBuildRange qbrGenre = qbds.addRange(fieldNum(AIBBookTable, Genre));

            qbrGenre.status(RangeStatus::Locked);
            qbrGenre.value(queryValue(genreFilter));
        }

]]></Source>
