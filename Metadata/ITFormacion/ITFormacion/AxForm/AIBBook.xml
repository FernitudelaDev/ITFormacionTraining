[Form]
public class AIBBook extends FormRun
{
    [DataField]
    class Author
    {
        public Common lookupReference(FormReferenceControl _formReferenceControl)
        {
            Common ret;

            ret = super(_formReferenceControl);

            return ret;
        }
    }
    AIBGenreEnum genreFilter;
    boolean needGenreFilter;
}
]]></Source>
