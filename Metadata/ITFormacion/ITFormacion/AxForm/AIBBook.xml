				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        super();

        element.getParamsFromArgs();
        //FormRun callerFormRun = element.args().caller();
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>getParamsFromArgs</Name>
				<Source><![CDATA[
    public void getParamsFromArgs()
    {
        Common callerRecord = element.args().record();
        MenuItemName callerItemName = element.args().menuItemName();

        if(callerItemName == menuItemDisplayStr(AIBBookGenreFilter) && callerRecord.TableId == tableNum(AIBAuthorTable))
        {
            AIBAuthorTable authorTable = callerRecord;
            authorTable.firstBookGenre();
            needGenreFilter = true;
        }
    }

]]></Source>
			</Method>
