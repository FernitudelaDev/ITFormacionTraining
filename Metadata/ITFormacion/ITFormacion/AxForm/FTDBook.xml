				<Source><![CDATA[
    NumberSeqFormHandler numberSeqNumBookId()
    {
        if (!numberSeqNumBookId)
        {
            numberSeqNumBookId = NumberSeqFormHandler::newForm(
            CustParameters::ftdNumRefBookId().NumberSequenceId,
            element,
            FTDBookTable_ds,
            fieldNum(FTDBookTable, Id)
        );
        }

        return numberSeqNumBookId;
    }

]]></Source>
