			<Method>
				<Name>getParamsFromArgs</Name>
				<Source><![CDATA[
    private void getParamsFromArgs()
    {
        Common          callerRecord = element.args().record();
        MenuItemName    callerItemName = element.args().menuItemName();

        if (callerItemName == menuItemDisplayStr(FTDBookGenreFiltered)
            && callerRecord.TableId == tableNum(FTDAuthorTable))
        {
            FTDAuthorTable authorTable  = callerRecord;
            genreFilter                 = authorTable.firstBookGenre();
            needGenreFilter             = true;
        }
    }

]]></Source>
