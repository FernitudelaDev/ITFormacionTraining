					<Method>
						<Name>clearExistingLinksAndAddGenreRange</Name>
						<Source><![CDATA[
        private void clearExistingLinksAndAddGenreRange()
        {
            QueryBuildDataSource qbds = FTDBookTable_q.dataSourceTable(tableNum(FTDBookTable));

            qbds.clearDynalinks();

            QuerybuildRange qbrGenre = qbds.addRange(fieldNum(FTDBookTable, Genre));

            qbrGenre.status(RangeStatus::Locked);
            qbrGenre.value(queryValue(genreFilter));
        }

]]></Source>
