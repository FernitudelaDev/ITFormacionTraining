				<Methods>
					<Method>
						<Name>modified</Name>
						<Source><![CDATA[
        public boolean modified()
        {
            boolean ret;
    
            ret = super();

            date filterDate = this.dateValue();

            if(filterDate > dateNull())
            {
                qbrBirthDate.value(strFmt("<%1", filterDate));
                qbrDeathDate.value(strFmt(">%1", filterDate));
                qbrDeathDateNullCheck.value(queryValue(dateNull()));                
            }
            else
            {
                //limpiamos los rangos para que no filtre. SI quisieramos filtrar por valor vacio
                //SysQueryRangeUtil::valueEmptyString();
                qbrBirthDate.value('');
                qbrDeathDate.value('');
                qbrDeathDateNullCheck.value('');
            }

            RRBAuthorTable_ds.executeQuery();
    
            return ret;
        }

]]></Source>
