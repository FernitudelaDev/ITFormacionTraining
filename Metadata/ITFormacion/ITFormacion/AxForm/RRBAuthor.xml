						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            QueryBuildDataSource qbds = RRBAuthorTable_q.dataSourceTable(tableNum(RRBAuthorTable));

            qbrBirthDate = qbds.addRange(fieldNum(RRBAuthorTable,BirthDate));
            qbrDeathDate = qbds.addRange(fieldNum(RRBAuthorTable, DeathDate));
            qbrDeathDateNullCheck = qbds.addRange(fieldNum(RRBAuthorTable, DeathDate));

            qbrBirthDate.status(RangeStatus::Hidden);
            qbrDeathDate.status(RangeStatus::Hidden);
            qbrDeathDateNullCheck.status(RangeStatus::Hidden);

        }

]]></Source>
