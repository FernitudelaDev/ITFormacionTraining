public class RRBBook extends FormRun
{
    RRBGenreEnum genreFilter;
    boolean needGenreFilter;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        //Se ejecuta antes del super porque dentro del super se hace el init del datasource
        element.getParamsFormArgs();

        super();        

        //FormRun callerFormRun = element.args().caller();       
        
    }

]]></Source>
			</Method>
			<Method>
				<Name>getParamsFormArgs</Name>
				<Source><![CDATA[
    private void getParamsFormArgs()
    {
        Common callerRecord = element.args().record();
        MenuItemName callerItemName = element.args().menuItemName();

        if(callerItemName == menuItemDisplayStr(RRBBookGenreFiltered)
            && callerRecord.TableId == tableNum(RRBAuthorTable))
        {
            RRBAuthorTable authorTable = callerRecord;
            genreFilter = authorTable.firstBookGenre();
            needGenreFilter = true;
        }
    }

]]></Source>
			</Method>
		</Methods>
		<DataSources xmlns="">
			<DataSource>
				<Name>RRBBookTable</Name>
				<Methods>
					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        public void init()
        {
            super();

            if(needGenreFilter)
            {
                this.clearExistingDynaLinksAndAddGenreRanges();
            }
            
        }

]]></Source>
					</Method>
					<Method>
						<Name>clearExistingDynaLinksAndAddGenreRanges</Name>
						<Source><![CDATA[
        private void clearExistingDynaLinksAndAddGenreRanges()
        {
            QueryBuildDataSource qbds = RRBBookTable_q.dataSourceTable(tableNum(RRBBookTable));

            qbds.clearDynalinks();

            QueryBuildRange qbrGenre = qbds.addRange(fieldNum(RRBBookTable, Genre));

            qbrGenre.status(RangeStatus::Locked);
            qbrGenre.value(queryValue(genreFilter));
        }

]]></Source>
