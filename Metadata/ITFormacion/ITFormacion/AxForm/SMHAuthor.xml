        public void init()
        {
            super();

            QueryBuildDataSource qbds = SMHAuthorTable_q.dataSourceTable(tableNum(SMHAuthorTable));

            qbrBirthDate = qbds.addRange(fieldNum(SMHAuthorTable, BirthDate));
            qbrDeathDate = qbds.addRange(fieldNum(SMHAuthorTable, DeathDate));
            qbrDeathDateNullCheck = qbds.addRange(fieldNum(SMHAuthorTable, DeathDate));

