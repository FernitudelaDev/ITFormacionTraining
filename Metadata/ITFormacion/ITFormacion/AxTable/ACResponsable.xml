		<Methods>
			<Method>
				<Name>insert</Name>
				<Source><![CDATA[
    public void insert()
    {
        if (this.ResponsableId == '')
        {
            this.ResponsableId = NumberSeq::newGetNum(CustParameters::ftdNumRefResponsableId()).num();
        }

        super();
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    /// <returns></returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        ret =   ret
                && this.validateLegalAge();
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateLegalAge</Name>
				<Source><![CDATA[
    public boolean validateLegalAge()
    {
        if(this.FechaNacimiento == dateNull())
        {
            return true;
        }
        date legalAgeDate = mkDate(
                                    dayOfMth(systemDateGet()),
                                    mthOfYr(systemDateGet()),
                                    year(systemDateGet()) - 18);

        if (this.FechaNacimiento > legalAgeDate)
        {
            return checkFailed("@ITFormacion:InvalidLegalAge");
        }

        return true;
    }

]]></Source>
			</Method>
		</Methods>
