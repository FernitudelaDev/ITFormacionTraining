				<Name>findRecId</Name>
				<Source><![CDATA[
    public static AIBAuthorTable findRecId(RefRecId _refRecId)
    {
        AIBAuthorTable authorTable;
        select firstonly authorTable
            where authorTable.RecId == _refRecId;

        return authorTable;
    }

