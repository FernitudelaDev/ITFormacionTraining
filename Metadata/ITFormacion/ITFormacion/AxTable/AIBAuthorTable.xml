				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;

        ret = super();

        if(ret 
            && this.DeathDate > dateNull()
            && this.BirthDate > this.DeathDate)
        {
            ret = checkFailed('@ITFormacion:ValidateDeathDateError');
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>setDeathDateEditableInForm</Name>
				<Source><![CDATA[
    public void setDeathDateEditableInForm()
    {
        FormDataSource formDataSource = FormDataUtil::getFormDataSource(this);

        if(formDataSource)
        {
            formDataSource.object(fieldNum(AIBAuthorTable, DeathDate)).allowEdit(this.IsDead);
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>modifiedIsDead</Name>
				<Source><![CDATA[
    public void modifiedIsDead()
    {
        if(!this.IsDead)
        {
            this.DeathDate = dateNull();
        }

        this.setDeathDateEditableInForm();
    }

]]></Source>
