		<Methods>
			<Method>
				<Name>shouldThrowExceptionOnZeroDelete</Name>
				<Source><![CDATA[
    public boolean shouldThrowExceptionOnZeroDelete(){return true;}

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;

        ret = super();

        ret = ret 
            && this.validateTotalQtyIsNotBelowZero()
            && this.validateTotalQtyIsPositive();

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateTotalQtyIsNotBelowZero</Name>
				<Source><![CDATA[
    private boolean validateTotalQtyIsNotBelowZero()
    {
        Qty totalSavedPerBook = AIBBookTable::findRecId(this.Book).currentInventory(this.RecId);

        if ((totalSavedPerBook + this.Qty) < 0)
        {
            return checkFailed("@ITFormacion:TransactionWouldMakeTheTotalNegatives");
        }
        else
        {
            return true;
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateTotalQtyIsPositive</Name>
				<Source><![CDATA[
    private boolean validateTotalQtyIsPositive()
    {
        if (this.Qty == 0)
        {
            return checkFailed("@ITFormacion:FieldQtyCannotBeZero");
        }
        else
        {
            return true;
        }
    }

]]></Source>
			</Method>
		</Methods>
