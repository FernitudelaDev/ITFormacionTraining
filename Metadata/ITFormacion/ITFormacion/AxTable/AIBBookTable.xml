				<Name>dispAuthorFullName</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    public display AIBAuthorFullName dispAuthorFullName()
    {
        AIBAuthorTable authorTable = AIBAuthorTable::findRecId(this.Author);
        return authorTable.FirstName + ' ' + authorTable.LastName;
    }

