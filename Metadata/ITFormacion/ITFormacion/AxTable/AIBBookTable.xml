			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    public static AIBBookTable findRecId(RecId _recid)
    {
        AIBBookTable bookTable;

        select firstonly bookTable
            where bookTable.RecId == _recid;

        return bookTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static AIBBookTable find(AIBId _id)
    {
        AIBBookTable bookTable;

        select firstonly bookTable
            where bookTable.Id == _id;

        return bookTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>selectCountByGenre</Name>
				<Source><![CDATA[
    public static int selectCountByGenre(AIBGenreEnum _genre)
    {
        AIBBookTable bookTable;

        select count(RecId) from bookTable
            group by Genre
            where bookTable.Genre == _genre;

        return bookTable.RecId;
    }

]]></Source>
