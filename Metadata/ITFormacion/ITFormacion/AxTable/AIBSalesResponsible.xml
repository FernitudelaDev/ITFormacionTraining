    // Validar el id
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret = super(_fieldIdToCheck);

        if (_fieldIdToCheck == fieldNum(AIBSalesResponsible, ResponsibleId))
        {
            if (this.ResponsibleId && !AIBResponsibleTable::exist(this.ResponsibleId))
            {
                ret = checkFailed(strFmt("El responsable '%1' no existe.", this.ResponsibleId));
            }
        }

        return ret;
    }

]]></Source>
