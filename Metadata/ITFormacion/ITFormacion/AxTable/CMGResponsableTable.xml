				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public boolean validateWrite()
    {
        boolean ret;

        ret = super();

        ret = ret
        && this.validateIsAdult();

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateIsAdult</Name>
				<Source><![CDATA[
    private boolean validateIsAdult()
    {
        Date limitDate = mkDate(dayOfMth(today()), mthOfYr(today()), year(today()) - 18);

        if (this.BirthDate > limitDate)
        {
            return checkFailed("@ITFormacion:ResponsableMustBeAdult");
        }

        return true;
    }

]]></Source>
			</Method>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    public static CMGResponsableTable findRecId(RefRecId _refRecId, boolean _forUpdate = false)
    {
        CMGResponsableTable responsableTable;

        if (_refRecId)
        {
            if (_forUpdate)
            {
                responsableTable.selectForUpdate(_forUpdate);
            }

            select firstonly responsableTable
            where responsableTable.RecId == _refRecId;
        }

        return responsableTable;
    }

]]></Source>
			</Method>
