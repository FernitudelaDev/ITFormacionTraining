			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    public static FTDBookTable findRecId(RecId _recId)
    {
        FTDBookTable bookTable;

        select firstonly bookTable
            where bookTable.RecId == _recId;

        return bookTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>SelectCountByGenre</Name>
				<Source><![CDATA[
    public static int SelectCountByGenre(SMHGenreEnum _genre)
    {
        FTDbookTable bookTable;

        select count(RecId) from bookTable
        group by Genre
        where bookTable.Genre == _genre;

        return bookTable.RecId;
    }

]]></Source>
