			<Method>
				<Name>dispAuthorFullName</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    public display SMHAuthorFullName dispAuthorFullName()
    {
        SMHAuthorTable authorTable = SMHAuthorTable::findRecId(this.Author);

        return authorTable.FirstName + ' ' + authorTable.LastName;
    }

]]></Source>
