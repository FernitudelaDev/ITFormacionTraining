				<Name>dispAuthorFullName</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethod(true)]
    public display FTDAuthorFullName dispAuthorFullName()
    {
        FTDAuthorTable authorTable = FTDAuthorTable::findRecId(this.Author);

        return authorTable.FirstName + ' ' + authorTable.LastName;
    }

]]></Source>
