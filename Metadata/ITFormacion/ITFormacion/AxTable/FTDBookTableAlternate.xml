			<Method>
				<Name>AuthorTableLookup</Name>
				<Source><![CDATA[
    public Common AuthorTableLookup(FormReferenceControl _formReferenceControl)
    {
        SysReferenceTableLookup refTableLookup = SysReferenceTableLookup::newParameters(tableNum(FTDAuthorTable), _formReferenceControl);

        refTableLookup.parmQuery(this.getLookupQuery());
        refTableLookup.addLookupfield(fieldNum(FTDAuthorTable, Id));
        refTableLookup.addLookupfield(fieldNum(FTDAuthorTable, FirstName));
        refTableLookup.addLookupfield(fieldNum(FTDAuthorTable, LastName));
        refTableLookup.addLookupfield(fieldNum(FTDAuthorTable, IsDead));
                
        return refTableLookup.performFormLookup();
    }

]]></Source>
			</Method>
			<Method>
				<Name>getLookupQuery</Name>
				<Source><![CDATA[
    private Query getLookupQuery()
    {
        Query               q = new Query();
        QuerybuildDataSource qbds = q.addDataSource(tableNum(FTDAuthorTable));
                
        qbds.addRange(fieldNum(FTDAuthorTable, IsDead)).value(queryValue(NoYes::No));

        return q;
    }

]]></Source>
