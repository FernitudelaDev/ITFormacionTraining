    /// <summary>
    ///
    /// </summary>
    /// <returns></returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();


        if(ret)
        {
            if(this.BirthDate > systemDateGet() - (18 * 365))
            {
                ret = checkFailed("El responsable debe ser mayor de edad");
            }
        }
    
        return ret;
    }

]]></Source>
