	<SourceCode>
		<Declaration><![CDATA[
public class RRBBookInventoryTransaction extends common
{
}
]]></Declaration>
		<Methods>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    /// <returns></returns>
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        ret = ret 
            && this.validateTotalQtyIsNotZero()
            && this.validateTotalQtyIsNotBellowZero();
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateTotalQtyIsNotBellowZero</Name>
				<Source><![CDATA[
    private boolean validateTotalQtyIsNotBellowZero()
    {
        Qty totalSavedPerBook = RRBBookTable::findRecId(this.Book).currentInventory(this.RecId);

        if((totalSavedPerBook + this.Qty) < 0)
        {
            return checkFailed("@ITFormacion:TransactionWouldMakeTheTotalNegative");
        }

        return true;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateTotalQtyIsNotZero</Name>
				<Source><![CDATA[
    private boolean validateTotalQtyIsNotZero()
    {
        if(this.Qty == 0)
        {
            return checkFailed("@ITFormacion:FieldQtyCannotBeZero");
        }

        return true;
    }

]]></Source>
			</Method>
		</Methods>
