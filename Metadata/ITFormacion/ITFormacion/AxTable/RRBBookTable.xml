		<Methods>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    public static RRBBookTable findRecId(RecId _recId)
    {
        RRBBookTable bookTable;

        select firstonly bookTable
            where bookTable.RecId == _recId;

        return bookTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static RRBBookTable find(RRBId _id)
    {
        RRBBookTable bookTable;

        select firstonly bookTable
            where bookTable.Id == _id;

        return bookTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>selectCountByGenre</Name>
				<Source><![CDATA[
    public static int selectCountByGenre(RRBGenreEnum _genre)
    {
        RRBBookTable bookTable;

        select count(RecId) from bookTable
            group by Genre
            where bookTable.Genre == _genre;

        return bookTable.RecId;
    }

]]></Source>
			</Method>
			<Method>
				<Name>dispAuthorFullName</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    /// 
    public display RRBAuthorFullName dispAuthorFullName()
    {
        RRBAuthorTable authorTable = RRBAuthorTable::findRecId(this.Author);

        return authorTable.FirstName + ' ' + authorTable.LastName;
    }

]]></Source>
