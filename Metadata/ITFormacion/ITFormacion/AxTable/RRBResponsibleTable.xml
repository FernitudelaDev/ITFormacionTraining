		<Methods>
			<Method>
				<Name>validateField</Name>
				<Source><![CDATA[
    public boolean validateField(FieldId _fieldIdToCheck)
    {
        boolean ret;
    
        ret = super(_fieldIdToCheck);
        
        if (ret && _fieldIdToCheck == fieldNum(RRBResponsibleTable, BirthDate))
        {
            ret = ret && this.validateBirthDate();
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateWrite</Name>
				<Source><![CDATA[
    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        ret = ret
            && this.validateBirthDate();
    
        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>validateBirthDate</Name>
				<Source><![CDATA[
    public boolean validateBirthDate()
    {
        boolean ret = true;

        if (this.BirthDate && this.BirthDate > dateMthFwd(today(), -216))
        {
            ret = checkFailed("@ITFormacion:ResponsibleMustBeLegalAge");
        }

        return ret;
    }

]]></Source>
			</Method>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static RRBResponsibleTable find(FTDId _Id, boolean _update = false)
    {
        RRBResponsibleTable rrbResponsibleTable;

        if (_Id)
        {
            rrbResponsibleTable.selectForUpdate(_update);
            
            select firstonly rrbResponsibleTable
                where rrbResponsibleTable.Id == _Id;
        }

        return rrbResponsibleTable;
    }

]]></Source>
			</Method>
			<Method>
				<Name>fullNameDisplay</Name>
				<Source><![CDATA[
    [SysClientCacheDataMethodAttribute(true)]
    public display Name fullNameDisplay()
    {
        return this.FirstName + " " + this.LastName;
    }

]]></Source>
