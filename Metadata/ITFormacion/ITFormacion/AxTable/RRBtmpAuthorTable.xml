			<Method>
				<Name>validateBirthAndDeathDate</Name>
				<Source><![CDATA[
    public boolean validateBirthAndDeathDate()
    {
        if(this.DeathDate > dateNull()
            && this.BirthDate > this.DeathDate)
        {
            return checkFailed("@ITFormacion:ValidateDeathDateError");
        }
        return true;
    }

]]></Source>
