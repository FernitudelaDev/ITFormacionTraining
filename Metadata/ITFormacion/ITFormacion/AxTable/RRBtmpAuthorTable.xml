			<Method>
				<Name>modifiedIsDate</Name>
				<Source><![CDATA[
    public void modifiedIsDate()
    {
        if(!this.IsDead)
        {
            this.DeathDate = dateNull();
        }

        this.setDeathDateEditableInForm();        
    }

]]></Source>
			</Method>
			<Method>
				<Name>setDeathDateEditableInForm</Name>
				<Source><![CDATA[
    public void setDeathDateEditableInForm()
    {
        FormDataSource formDataSource = FormDataUtil::getFormDataSource(this);

        if(formDataSource)
        {
            formDataSource.object(fieldNum(RRBtmpAuthorTable, DeathDate)).allowEdit(this.IsDead);
        }
    }

]]></Source>
			</Method>
			<Method>
				<Name>firstBookGenre</Name>
				<Source><![CDATA[
    public RRBGenreEnum firstBookGenre()
    {
        RRBBookTable book;

        select firstonly Genre
            from book
            where this.RecId == book.Author;

        return book.Genre;

    }

]]></Source>
