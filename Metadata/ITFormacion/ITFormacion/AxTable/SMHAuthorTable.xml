			<Method>
				<Name>modifiedIsDead</Name>
				<Source><![CDATA[
    public void modifiedIsDead()
    {
        if (!this.IsDead)
        {
            this.DeathDate = dateNull();
        }

        this.setDeathDateEditableInForm();
    }

]]></Source>
			</Method>
			<Method>
				<Name>setDeathDateEditableInForm</Name>
				<Source><![CDATA[
    public void setDeathDateEditableInForm()
    {
        FormDataSource formDataSource = FormDataUtil::getFormDataSource(this);

        if (formDataSource)
        {
            formDataSource.object(fieldNum(SMHAuthorTable, DeathDate)).allowEdit(this.IsDead);
        }

    }

]]></Source>
			</Method>
			<Method>
				<Name>findRecId</Name>
				<Source><![CDATA[
    public static SMHAuthorTable findRecId(RefRecId _refRecId)
    {
        SMHAuthorTable author;

        select firstonly author
        where author.RecId == _refRecId;

        return author;
    }

]]></Source>
