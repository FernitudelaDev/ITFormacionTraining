    public boolean validateWrite()
    {
        boolean ret;
    
        ret = super();

        if (ret && this.BirthDate > dateMthFwd(systemDateGet(), -216))
        {
            ret = checkFailed("@ITFormacion:ResponsibleMustBeAdult");
        }
    
        return ret;
    }

]]></Source>
