    private boolean validateDataSource_DS1(DataEntityRuntimeContext _entityCtx, ACBookEntity _aCBookEntity, DataEntityDataSourceRuntimeContext _dataSourceCtx, ACBookTable _aCBookTable)
    {
        boolean rtrn = true;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, '', '', conNull(), _aCBookEntity, fieldnum(ACBookEntity, Id), 'ACBookEntity.Id', _aCBookTable, fieldnum(ACBookTable, Id), false/*disallowEditOnCreate*/, true/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, '', '', conNull(), _aCBookEntity, fieldnum(ACBookEntity, Name), 'ACBookEntity.Name', _aCBookTable, fieldnum(ACBookTable, Name), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateMappedDataSourceField(_entityCtx, _dataSourceCtx, '', '', conNull(), _aCBookEntity, fieldnum(ACBookEntity, Genre), 'ACBookEntity.Genre', _aCBookTable, fieldnum(ACBookTable, Genre), false/*disallowEditOnCreate*/, false/*disallowEdit*/, true/*callValidateField*/, 1) ? rtrn : false;
        rtrn = this.validateDataSourceExtensions(_entityCtx, _aCBookEntity, _dataSourceCtx, _aCBookTable) ? rtrn : false;
        return rtrn;
    }
