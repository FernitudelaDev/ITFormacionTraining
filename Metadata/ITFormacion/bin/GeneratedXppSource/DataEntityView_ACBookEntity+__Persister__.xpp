    protected boolean hasDataSourceRecordChanged(int _dataSourceId, common _originalRecord, common _updatedRecord)
    {
        boolean hasDataSourceRecordChanged_ = true;
        
        // The method is called for OCC validation and only upon data sources that have One-to-Many relationships.
        
        switch (_dataSourceId)
        {
            case #AuthorTable_ID:
                hasDataSourceRecordChanged_ = this.hasDataSourceRecordChanged_DS2(_originalRecord, _updatedRecord);
                break;
        }
        return hasDataSourceRecordChanged_;
    }
    protected void initializeDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.initializeDataSource(_entityCtx, 'ACBookTable', m_ACBookTable, this.getDataSourceId('ACBookTable'), this.getDataSourceRuntimeId('ACBookTable'), false/* optional */, false/* readonly */, false/* oneToMany */, false/* dateEffective */, false/* applyDateFilter */);
        this.initializeDataSource(_entityCtx, 'AuthorTable', m_AuthorTable, this.getDataSourceId('AuthorTable'), this.getDataSourceRuntimeId('AuthorTable'), false/* optional */, true/* readonly */, true/* oneToMany */, false/* dateEffective */, false/* applyDateFilter */);
        this.initializeDataSourcesExtensions(_entityCtx);
    }
    private boolean hasDataSourceRecordChanged_DS2(ACAuthorTable _originalRecord, ACAuthorTable _updatedRecord)
    {
        if (_originalRecord.Id != _updatedRecord.Id)
        {
            return true;
        }
        return false;
    }
    private ACBookTable LookForUniqueKeyMatch_DS1(ACBookEntity _aCBookEntity, ACBookTable _aCBookTable)
    {
        ACBookTable aCBookTable_ = null;
        
        select
            forUpdate
            firstOnly
                aCBookTable_
        where
            aCBookTable_.Id == _aCBookTable.Id
        ;
        
        if (aCBookTable_)
        {
            return aCBookTable_;
        }
        
        return aCBookTable_;
    }
    private ACAuthorTable LookForUniqueKeyMatch_DS2(ACBookEntity _aCBookEntity, ACAuthorTable _authorTable)
    {
        ACAuthorTable aCAuthorTable_ = null;
        
        // Ensuring only fields in the selection list should be accessed for read-only data source.
        aCAuthorTable_.checkInvalidFieldAccess(true);
        
        select
            firstOnly
                // Specify explicit field selection for read-only data source.
                Id, RecId
            from
                aCAuthorTable_
        where
            aCAuthorTable_.Id == _authorTable.Id
        ;
        
        if (aCAuthorTable_)
        {
            return aCAuthorTable_;
        }
        
        return aCAuthorTable_;
    }

