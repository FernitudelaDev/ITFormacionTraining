    private void mapToMatchingRecord_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, ACBookTable _aCBookTable, ACBookTable _matchingRecord)
    {
        // map data changes in bound fields.
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookTable, fieldnum(ACBookTable, Id), _matchingRecord, fieldnum(ACBookTable, Id), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookTable, fieldnum(ACBookTable, Name), _matchingRecord, fieldnum(ACBookTable, Name), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookTable, fieldnum(ACBookTable, Genre), _matchingRecord, fieldnum(ACBookTable, Genre), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookTable, fieldnum(ACBookTable, Author), _matchingRecord, fieldnum(ACBookTable, Author), 1);
        this.mapToMatchingRecordExtensions(_dataSourceCtx, tablestr(ACBookEntity), _aCBookTable, _matchingRecord);
    }
    private void mapToMatchingRecord_DS2(DataEntityDataSourceRuntimeContext _dataSourceCtx, ACAuthorTable _authorTable, ACAuthorTable _matchingRecord)
    {
        // map data changes in bound fields.
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _authorTable, fieldnum(ACAuthorTable, Id), _matchingRecord, fieldnum(ACAuthorTable, Id), 1);
