Private class __Persister__
extends SysDataEntityPersister
{
    // Data source ID macros
    #define.ACBookTable_ID(1)
    #define.AuthorTable_ID(2)
    
    // Data source buffers
    ACBookTable m_ACBookTable;
    ACAuthorTable m_AuthorTable;
    
    protected void mapEntityToDataSources(DataEntityRuntimeContext _entityCtx)
    {
        this.validateFieldFailed = false;
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('ACBookTable'));
        this.mapEntityToDataSource(_entityCtx, _entityCtx.getRuntimeContextByName('AuthorTable'));
        this.mapEntityToDataSourcesExtensions(_entityCtx);
        if(this.validateFieldFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    private boolean isAnyFieldSet_DS2(ACAuthorTable _authorTable, DataEntityDataSourceRuntimeContext _dataSourceCtx, DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = false;
        if(_authorTable.isFieldSet(fieldnum(ACAuthorTable,Id)))
        {
            return true;
        }
        rtrn = this.isAnyFieldSet_Extensions(_entityCtx, _dataSourceCtx, _authorTable) ? true : false;
        return rtrn;
    }
    private void foreignKeyPropagation_DS1(DataEntityRuntimeContext _entityCtx, ACBookTable _aCBookTable)
    {
        ACAuthorTable authorTable_ = _entityCtx.getRuntimeContextByName('AuthorTable').getBuffer();
        // do not set foreign key values if they are same to make sure validation is not fired unless value changed
        if(_aCBookTable.Author != authorTable_.RecId)
        {
            _aCBookTable.Author = authorTable_.RecId;
        }
        
        // foreign key value validation
        boolean validationFailed = false;
        DataEntityDatabaseOperation dataSourceDBOperation = _entityCtx.getRuntimeContextByName('ACBookTable').getDatabaseOperation();
        ACBookEntity dataEntityRecord = _entityCtx.getEntityRecord();
        
        if(!dataEntityRecord.skipDataSourceValidateField(fieldnum(ACBookEntity, Author)))
        {
            if(!this.validateDataSourceField(dataSourceDBOperation, 'ACBookTable.Author', _aCBookTable, fieldnum(ACBookTable, Author), false/*disallowEditOnCreate*/, false/*disallowEdit*/, false/*callValidateField*/, 1))
            {
                validationFailed = true;
            }
        }
        
        if(validationFailed)
        {
            throw Exception::ViewDataSourceValidation;
        }
    }
    protected boolean saveDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // save data sources in topological order.
        {
            // save/update data sources referenced by [ACBookTable].
            {
                // handle datasources which are part of extensions and need to be saved before [AuthorTable]
                if(!this.preSaveDataSource(_entityCtx, 'AuthorTable'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('AuthorTable');
                // propagates foreign key values from referenced data sources which are part of extensions.
                this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
                if(this.isAnyFieldSet_DS2(_dataSourceCtx.getBuffer(),_dataSourceCtx,_entityCtx))
                {
                    // invoke conflict detection for read-only data source.
                    ACAuthorTable resolvedRecord = this.detectConflictForDataSource(_entityCtx, _dataSourceCtx);
                    if(!resolvedRecord)
                    {
                        ACAuthorTable authorTable_ = _dataSourceCtx.getBuffer();
                        if((authorTable_.Id))
                        {
                            container dataSourceKeys = ["Id"];
                            container resolvedRecordValues = [resolvedRecord.Id];
                            container dataSourceConflictingValues = [authorTable_.Id];
                            str errorMessage = "";
                            for(int i = 1; i <= conLen(dataSourceKeys); i++)
                            {
                                if(conPeek(dataSourceConflictingValues, i))
                                {
                                    errorMessage += strfmt("'%1': %2, ", conPeek(dataSourceKeys, i), conPeek(resolvedRecordValues, i));
                                }
                            }
                            errorMessage = strDel(errorMessage, strLen(errorMessage) - 1, 2);
                            checkFailed(strfmt("@ApplicationPlatform:DataEntityReadonlyDataSourceNotFoundWithKey", _dataSourceCtx.name(), errorMessage));
                            throw Exception::ViewDataSourceValidation;
                        }
                    }
                    // marks the read-only data source as 'saved' and skips actual insert/update operation.
                    _dataSourceCtx.setDataSaved(true);
                }
                // in case of update marks the read-only data source as 'saved' and skips actual insert/update operation.
                else if(_dataSourceCtx.getDatabaseOperation() == DataEntityDatabaseOperation::Update)
                {
                    _dataSourceCtx.setDataSaved(true);
                }
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // inserts/updates data source [AuthorTable].
                if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
                {
                    // returns from here if an inner joined data source fails to be saved.
                    return false;
                }
                this.postSaveDataSource();
            }
            // handle datasources which are part of extensions and need to be saved before [ACBookTable]
            if(!this.preSaveDataSource(_entityCtx, 'ACBookTable'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('ACBookTable');
            // propagates foreign key values from referenced data sources which are part of extensions.
            this.foreignKeyPropagationExtensions(_entityCtx, _dataSourceCtx);
            // propagates foreign key values from referenced data sources.
            this.foreignKeyPropagation_DS1(_entityCtx, _dataSourceCtx.getBuffer());
            // inserts/updates data source [ACBookTable].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    protected boolean deleteDataSources(DataEntityRuntimeContext _entityCtx)
    {
        boolean rtrn = true;
        DataEntityDataSourceRuntimeContext _dataSourceCtx = null;
        // delete data sources in reverse topological order.
        {
            // handle datasources which are part of extensions and need to be saved before [ACBookTable]
            if(!this.preSaveDataSource(_entityCtx, 'ACBookTable'))
            {
                return false;
            }
            _dataSourceCtx = _entityCtx.getRuntimeContextByName('ACBookTable');
            // deletes data source [ACBookTable].
            if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
            {
                // returns from here if the root data source fails to be saved.
                return false;
            }
            this.postSaveDataSource();
            // deletes data sources referenced by [ACBookTable].
            {
                // handle datasources which are part of extensions and need to be saved before [AuthorTable]
                if(!this.preSaveDataSource(_entityCtx, 'AuthorTable'))
                {
                    return false;
                }
                _dataSourceCtx = _entityCtx.getRuntimeContextByName('AuthorTable');
                // skips delete operation against read-only data source.
                // marks the read-only data source as 'saved' and skips actual delete operation.
                _dataSourceCtx.setDataSaved(true);
                _dataSourceCtx.setDatabaseOperation(DataEntityDatabaseOperation::None);
                // deletes data source [AuthorTable].
                if(!this.saveDataSource(_entityCtx, _dataSourceCtx))
                {
                    // returns from here if an inner joined data source fails to be saved.
                    return false;
                }
                this.postSaveDataSource();
            }
        }
        // handle datasources which are part of extensions and need to be saved in last 
        this.preSaveDataSource(_entityCtx, '');
        return rtrn;
    }
    private void mapToDataSource_DS1(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx, ACBookTable _aCBookTable, ACBookEntity _aCBookEntity)
    {
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookEntity, fieldnum(ACBookEntity, Id), _aCBookTable, fieldnum(ACBookTable, Id), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookEntity, fieldnum(ACBookEntity, Name), _aCBookTable, fieldnum(ACBookTable, Name), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookEntity, fieldnum(ACBookEntity, Genre), _aCBookTable, fieldnum(ACBookTable, Genre), 1);
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookEntity, fieldnum(ACBookEntity, Author), _aCBookTable, fieldnum(ACBookTable, Author), 1);
        
        this.mapToDataSourceExtensions(_dataSourceCtx, _aCBookTable, _aCBookEntity);
        _aCBookTable.trackFieldExternallySet(false);
    }
    private void mapToDataSource_DS2(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx, ACAuthorTable _authorTable, ACBookEntity _aCBookEntity)
    {
        this.mapEntityFieldToDataSourceField(_dataSourceCtx.getDatabaseOperation(), _aCBookEntity, fieldnum(ACBookEntity, AuthorTable_Id), _authorTable, fieldnum(ACAuthorTable, Id), 1);
        
        this.mapToDataSourceExtensions(_dataSourceCtx, _authorTable, _aCBookEntity);
        _authorTable.trackFieldExternallySet(false);
    }
    protected void doMapEntityToDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #ACBookTable_ID:
                this.mapToDataSource_DS1(_entityCtx, _dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            case #AuthorTable_ID:
                this.mapToDataSource_DS2(_entityCtx, _dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapEntityToDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    private void mapFromDataSource_DS1(DataEntityDataSourceRuntimeContext _dataSourceCtx, ACBookTable _aCBookTable, ACBookEntity _aCBookEntity)
    {
        this.mapDataSourceFieldToEntityField(_aCBookTable, fieldnum(ACBookTable, Id), _aCBookEntity, fieldnum(ACBookEntity, Id), false);
        this.mapDataSourceFieldToEntityField(_aCBookTable, fieldnum(ACBookTable, Name), _aCBookEntity, fieldnum(ACBookEntity, Name), false);
        this.mapDataSourceFieldToEntityField(_aCBookTable, fieldnum(ACBookTable, Genre), _aCBookEntity, fieldnum(ACBookEntity, Genre), false);
        this.mapDataSourceFieldToEntityField(_aCBookTable, fieldnum(ACBookTable, Author), _aCBookEntity, fieldnum(ACBookEntity, Author), false);
        this.mapFromDataSourceExtensions(_dataSourceCtx, _aCBookTable, _aCBookEntity);
        // map system fields (e.g. recid and recversion) from data source buffer to view record.
        _aCBookEntity.fromViewDataSource(_dataSourceCtx.id(), _aCBookTable);
    }
    private void mapFromDataSource_DS2(DataEntityDataSourceRuntimeContext _dataSourceCtx, ACAuthorTable _authorTable, ACBookEntity _aCBookEntity)
    {
        this.mapDataSourceFieldToEntityField(_authorTable, fieldnum(ACAuthorTable, Id), _aCBookEntity, fieldnum(ACBookEntity, AuthorTable_Id), false);
        this.mapFromDataSourceExtensions(_dataSourceCtx, _authorTable, _aCBookEntity);
        // map system fields (e.g. recid and recversion) from data source buffer to view record.
        _aCBookEntity.fromViewDataSource(_dataSourceCtx.id(), _authorTable);
    }
    protected void doMapDataSourceToEntity(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        switch(_dataSourceCtx.id())
        {
            case #ACBookTable_ID:
                this.mapFromDataSource_DS1(_dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            case #AuthorTable_ID:
                this.mapFromDataSource_DS2(_dataSourceCtx, _dataSourceCtx.getBuffer(), _entityCtx.getEntityRecord());
                break;
            default :
                this.doMapDataSourceToEntityExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
    }
    protected Common doFindDataSource(DataEntityRuntimeContext _entityCtx, DataEntityDataSourceRuntimeContext _dataSourceCtx)
    {
        Common rtrn = null;
        switch(_dataSourceCtx.id())
        {
            case #ACBookTable_ID:
                rtrn = this.LookForUniqueKeyMatch_DS1(_entityCtx.getEntityRecord(), _dataSourceCtx.getBuffer());
                break;
            case #AuthorTable_ID:
                rtrn = this.LookForUniqueKeyMatch_DS2(_entityCtx.getEntityRecord(), _dataSourceCtx.getBuffer());
                break;
            default :
                rtrn = this.doFindDataSourceExtensions(_entityCtx, _dataSourceCtx);
                break;
        }
        return rtrn;
    }
